[gd_resource type="Resource" script_class="QuestProfile" format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://scripts/quests/quest_outcome.gd" id="2_outcome_script"]
[ext_resource type="Resource" path="res://resources/quest_outcomes/quest_outcome_forest_secure_success.tres" id="3_success"]
[ext_resource type="Resource" path="res://resources/quest_outcomes/quest_outcome_forest_secure_setback.tres" id="4_setback"]

[resource]
script = ExtResource("1_profile")
quest_key = "secure"
behaviour = "secure"
required_role = "security"
translation_key_name = "QUEST_TYPE_SECURE"
description_key = "QUEST_DESC_FOREST_SECURE"
