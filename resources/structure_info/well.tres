[gd_resource type="Resource" script_class="PlaceableStructureInfo" format=3]
[ext_resource type="Script" path="res://scripts/structures/placeable_info.gd" id="placeable"]
[ext_resource type="Script" path="res://tools/inventory/scripts/data/item_info.gd" id="item"]
[ext_resource type="Resource" path="res://resources/item_info/well_blueprint.tres" id="blueprint"]
[ext_resource type="PackedScene" path="res://scenes/tops/buildable_well.tscn" id="scene"]
[ext_resource type="Script" path="res://scripts/structures/settlement_placement_handler.gd" id="handler"]
[resource]
script = ExtResource("placeable")
id = "well"
translation_key_name = "STRUCTURE_WELL_NAME"
build_cost = Dictionary[ExtResource("item"), int]({ExtResource("blueprint"):1})
placement_handler = ExtResource("handler")
required_settlement_level = 2
minimum_distance_from_other_structures = 0
randomize_rotation = false
packed_scene = ExtResource("scene")
type = 4
