[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hub_overview_ui.gd" id="1_hub"]
[ext_resource type="Theme" path="res://themes/fantasy_buttons.tres" id="2_buttons"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hub"]
bg_color = Color(0.97, 0.9, 0.76, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.42, 0.31, 0.2, 0.45)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_standing"]
bg_color = Color(0.92, 0.84, 0.67, 0.55)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.42, 0.31, 0.2, 0.3)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_prestige"]
bg_color = Color(0.32, 0.22, 0.13, 0.9)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="HubOverview" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_hub")
script = ExtResource("1_hub")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Header" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.2, 0.13, 1)
theme_override_font_sizes/font_size = 18
text = "HUB_OPERATIONS_TITLE"
uppercase = true

[node name="Subtitle" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.31, 0.2, 0.85)
text = "HUB_OPERATIONS_SUBTITLE"

[node name="StandingPanel" type="PanelContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
tooltip_text = "GUILD_STANDING_HEADER"
theme_override_styles/panel = SubResource("StyleBoxFlat_standing")

[node name="Margin" type="MarginContainer" parent="Margin/Scroll/VBox/StandingPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 7
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 7

[node name="Content" type="VBoxContainer" parent="Margin/Scroll/VBox/StandingPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Header" type="Label" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.36, 0.27, 0.18, 1)
theme_override_font_sizes/font_size = 12
text = "GUILD_STANDING_HEADER"
uppercase = true

[node name="Metrics" type="HBoxContainer" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Reputation" type="VBoxContainer" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Reputation"]
layout_mode = 2
text = "GUILD_REPUTATION_LABEL"

[node name="Progress" type="ProgressBar" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Reputation"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
max_value = 10.0
show_percentage = false

[node name="Value" type="Label" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Reputation"]
layout_mode = 2
text = "0 / 10"

[node name="Notoriety" type="VBoxContainer" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Notoriety"]
layout_mode = 2
text = "GUILD_NOTORIETY_LABEL"

[node name="Progress" type="ProgressBar" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Notoriety"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
max_value = 5.0
show_percentage = false

[node name="Value" type="Label" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Notoriety"]
layout_mode = 2
text = "0 / 5"

[node name="Prestige" type="PanelContainer" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics"]
custom_minimum_size = Vector2(105, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_prestige")

[node name="Margin" type="MarginContainer" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Prestige"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 4

[node name="Content" type="VBoxContainer" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Prestige/Margin"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Prestige/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.86, 0.67, 1)
theme_override_font_sizes/font_size = 11
text = "GUILD_PRESTIGE_LABEL"
horizontal_alignment = 1
uppercase = true

[node name="Value" type="Label" parent="Margin/Scroll/VBox/StandingPanel/Margin/Content/Metrics/Prestige/Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(1, 0.94, 0.78, 1)
theme_override_font_sizes/font_size = 22
text = "0"
horizontal_alignment = 1
vertical_alignment = 1

[node name="FactionsHeader" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.2, 0.13, 1)
text = "HUB_FACTIONS_HEADER"
uppercase = true

[node name="FactionTabs" type="HBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme = ExtResource("2_buttons")
theme_override_constants/separation = 5

[node name="FactionDetails" type="VBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="OperationsHeader" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.2, 0.13, 1)
text = "HUB_ACTIVE_OPERATIONS"
uppercase = true

[node name="Operations" type="VBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 5
