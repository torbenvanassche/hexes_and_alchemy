[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/light.theme" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/journal_ui.gd" id="2_journal"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/journal_page.tscn" id="3_page"]
[ext_resource type="Theme" path="res://themes/fantasy_buttons.tres" id="4_buttons"]

[node name="JournalPage" type="Control"]
custom_minimum_size = Vector2(430, 330)
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_journal")
page_scene = ExtResource("3_page")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="GuildStanding" type="VBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="StandingHeader" type="Label" parent="MarginContainer/VBoxContainer/GuildStanding"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "GUILD_STANDING_HEADER"
uppercase = true

[node name="ReputationRow" type="HBoxContainer" parent="MarginContainer/VBoxContainer/GuildStanding"]
layout_mode = 2

[node name="ReputationTitle" type="Label" parent="MarginContainer/VBoxContainer/GuildStanding/ReputationRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "GUILD_REPUTATION_LABEL"

[node name="ReputationValue" type="Label" parent="MarginContainer/VBoxContainer/GuildStanding/ReputationRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
horizontal_alignment = 2

[node name="ReputationProgress" type="ProgressBar" parent="MarginContainer/VBoxContainer/GuildStanding"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
max_value = 10.0
show_percentage = false

[node name="NotorietyRow" type="HBoxContainer" parent="MarginContainer/VBoxContainer/GuildStanding"]
layout_mode = 2

[node name="NotorietyTitle" type="Label" parent="MarginContainer/VBoxContainer/GuildStanding/NotorietyRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "GUILD_NOTORIETY_LABEL"

[node name="NotorietyValue" type="Label" parent="MarginContainer/VBoxContainer/GuildStanding/NotorietyRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
horizontal_alignment = 2

[node name="NotorietyProgress" type="ProgressBar" parent="MarginContainer/VBoxContainer/GuildStanding"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
max_value = 5.0
show_percentage = false

[node name="PrestigeRow" type="HBoxContainer" parent="MarginContainer/VBoxContainer/GuildStanding"]
layout_mode = 2

[node name="PrestigeTitle" type="Label" parent="MarginContainer/VBoxContainer/GuildStanding/PrestigeRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "GUILD_PRESTIGE_LABEL"

[node name="PrestigeValue" type="Label" parent="MarginContainer/VBoxContainer/GuildStanding/PrestigeRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
horizontal_alignment = 2

[node name="ChapterNavigation" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme = ExtResource("4_buttons")
theme_override_constants/separation = 8

[node name="PreviousPageButton" type="Button" parent="MarginContainer/VBoxContainer/ChapterNavigation"]
custom_minimum_size = Vector2(42, 0)
layout_mode = 2
tooltip_text = "JOURNAL_PREVIOUS_CHAPTER"
theme_override_font_sizes/font_size = 18
text = "<"

[node name="ChapterSelector" type="OptionButton" parent="MarginContainer/VBoxContainer/ChapterNavigation"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "JOURNAL_CHAPTER_SELECTOR"
theme_override_font_sizes/font_size = 18
alignment = 1

[node name="NextPageButton" type="Button" parent="MarginContainer/VBoxContainer/ChapterNavigation"]
custom_minimum_size = Vector2(42, 0)
layout_mode = 2
tooltip_text = "JOURNAL_NEXT_CHAPTER"
theme_override_font_sizes/font_size = 18
text = ">"

[node name="PageDivider" type="HSeparator" parent="MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="PageHost" type="Control" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
clip_contents = true
