[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://tools/input_prompts/scripts/controller_keyboard.gd" id="1"]

[node name="Keyboard" type="PanelContainer"]
visible = false
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -160.0
offset_right = 330.0
offset_bottom = 160.0
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
text = "UI_EDIT_TEXT"
theme_type_variation = &"SectionTitle"

[node name="Preview" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ControllerTextPreview"
text_overrun_behavior = 3

[node name="Keys" type="GridContainer" parent="Content"]
layout_mode = 2
columns = 10
size_flags_vertical = 3

[node name="Actions" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Space" type="Button" parent="Content/Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "UI_SPACE"

[node name="Delete" type="Button" parent="Content/Actions"]
layout_mode = 2
text = "UI_DELETE_CHARACTER"

[node name="Shift" type="Button" parent="Content/Actions"]
layout_mode = 2
text = "UI_SHIFT"

[node name="Done" type="Button" parent="Content/Actions"]
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "UI_DONE"
