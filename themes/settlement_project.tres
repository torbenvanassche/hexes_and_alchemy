[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="Font_body"]
font_names = PackedStringArray("Segoe UI", "Noto Sans")

[sub_resource type="StyleBoxFlat" id="Style_button"]
bg_color = Color(0.25, 0.19, 0.12, 1)
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

[sub_resource type="StyleBoxFlat" id="Style_hover"]
bg_color = Color(0.38, 0.29, 0.17, 1)
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

[sub_resource type="StyleBoxFlat" id="Style_focus"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.8, 0.57, 0.21, 1)

[resource]
default_font = SubResource("Font_body")
default_font_size = 16
Label/colors/font_color = Color(0.17, 0.13, 0.08, 1)
Label/font_sizes/font_size = 16
Button/colors/font_color = Color(1, 0.95, 0.83, 1)
Button/colors/font_hover_color = Color(1, 1, 0.94, 1)
Button/colors/font_pressed_color = Color(1, 0.95, 0.83, 1)
Button/styles/normal = SubResource("Style_button")
Button/styles/hover = SubResource("Style_hover")
Button/styles/pressed = SubResource("Style_hover")
Button/styles/focus = SubResource("Style_focus")
